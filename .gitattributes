# Auto-detect text files and perform LF normalization
* text=auto

# Declare files that should always have LF line endings on checkout
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.sh text eol=lf

# Denotate binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
